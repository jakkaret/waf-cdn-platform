# WAF & CDN SSL Termination Caddyfile
# ----------------------------------

{
    # Enable On-Demand TLS
    on_demand_tls {
        # Query backend API to verify if the domain is registered and has valid DNS before requesting SSL
        ask http://host.docker.internal:8000/api/domains/check-ssl-allowed
    }
    
    # Use Local CA for local test domains (e.g. .test, .local) automatically
    local_certs
}

# Catch-all HTTPS block for all customer domains
:443 {
    tls {
        # Trigger On-Demand Let's Encrypt / ZeroSSL certificate request during handshake
        on_demand
    }

    # Forward to stock Nginx WAF Engine running ModSecurity
    reverse_proxy http://waf:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Catch-all HTTP block (Handles HTTP Let's Encrypt challenges and redirects)
:80 {
    # Let Caddy handle Let's Encrypt HTTP-01 challenges internally.
    # For normal HTTP traffic, redirect to HTTPS.
    redir https://{host}{uri}
}
