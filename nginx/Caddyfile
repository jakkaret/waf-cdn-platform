# Main node Caddy: TLS for the dashboard only.
# ---------------------------------------------------------------
# Protected sites never come through here: their DNS points at the edges, and
# the edges reach the WAF on Main:8080 directly (ufw allows the edge IPs only).
# Any other Host arriving at Main:80/443 is a request that skipped the edge
# layer, so it is refused instead of being forwarded to the WAF.

{
    email admin@waf-it-kku.online
    auto_https disable_redirects
}

# 1. WAF Dashboard Web UI (HTTP & HTTPS)
waf-it-kku.online, www.waf-it-kku.online, main.waf-it-kku.online, dash.waf-it-kku.online, http://waf-it-kku.online, http://www.waf-it-kku.online, http://main.waf-it-kku.online, http://dash.waf-it-kku.online {
    reverse_proxy http://host.docker.internal:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# 2. Direct IP access shows the dashboard; every other Host is refused.
http://178.104.53.123, http://localhost, :80 {
    @dashboard host 178.104.53.123 localhost
    handle @dashboard {
        reverse_proxy http://host.docker.internal:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle {
        respond "Direct access is not allowed. Use the site's public address." 403
    }
}
