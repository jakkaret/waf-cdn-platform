# Native Challenge Engine integration.
# This is a template: the image's entrypoint renders it with envsubst into
# /etc/nginx/includes/captcha_server.conf. ML_RELAY_SECRET comes from .env
# (env_file) and is the shared secret of the dashboard's internal ML relay
# (F-019); nginx -t fails on an unset value instead of sending an empty one.
# The auth subrequest runs before the legacy-origin location. On a protected
# path, GET/HEAD without clearance gets the challenge page (401) and any other
# method except OPTIONS gets 403 (otp_engine._deny). $waf_client_ip is the
# visitor's real IP even behind the CDN edge (map in default.conf.template).
# Phase 1.2: shadow-only ML decision hook.
# It is fail-open and does not enforce block/challenge actions.
location = /internal-ml-shadow {
    internal;
    proxy_method GET;
    proxy_pass http://host.docker.internal:8000/api/ml/shadow/decision;
    proxy_set_header X-Internal-ML-Relay "${ML_RELAY_SECRET}";
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-Host $host;
    proxy_set_header X-Original-IP $waf_client_ip;
    proxy_set_header X-Original-User-Agent $http_user_agent;
    proxy_set_header Host $host;
    proxy_intercept_errors on;
    error_page 500 502 503 504 =204 /internal-ml-shadow-allow;
}

location = /internal-ml-shadow-allow {
    internal;
    return 204;
}

# Gen3 3.1-A: target of the `mirror /internal-ml-capture;` directive added
# to each location / block in default.conf.template. Unlike /internal-ml-
# shadow above, this is invoked via nginx's mirror mechanism, not
# auth_request -- its response is always discarded by nginx itself, so no
# error_page fail-open trick is needed here the way the shadow hook needs
# one. Proxies to dashboard-backend's existing capture relay (POST
# /api/ml/capture), which itself fails open and only persists anything for
# hosts in ml/capture_telemetry.py's allowlist.
location = /internal-ml-capture {
    internal;
    # A host in ML enforce mode is already scored by the inline gate below
    # (one verdict per request, with the action it took).
    if ($ml_gate) {
        return 204;
    }
    proxy_method POST;
    proxy_pass http://host.docker.internal:8000/api/ml/capture;
    proxy_set_header X-Internal-ML-Relay "${ML_RELAY_SECRET}";
    proxy_set_header X-Original-Host $host;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-Request-ID $waf_request_id;
    proxy_set_header Content-Type $content_type;
    proxy_set_header Host $host;
    proxy_read_timeout 2s;
    proxy_connect_timeout 1s;
}

# Gen 3 inline gate (nginx/njs/mlgate.js) of a host in ML enforce mode:
# njs sends the request body here as a subrequest; dashboard-backend scores it
# and answers the action on X-WAF-ML-Action. $ml_gate (the origin's bands,
# from the nginx map) is sent as X-ML-Gate. Only the headers below go out --
# not the visitor's cookies or authorization. The relay itself fails open
# within its 0.5 s budget; a hung relay costs at most these timeouts.
location = /internal-ml-gate {
    internal;
    proxy_method POST;
    proxy_pass http://host.docker.internal:8000/api/ml/gate;
    proxy_pass_request_headers off;
    proxy_set_header X-Internal-ML-Relay "${ML_RELAY_SECRET}";
    proxy_set_header X-ML-Gate $ml_gate;
    proxy_set_header X-Original-Host $host;
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-Request-ID $waf_request_id;
    proxy_set_header Content-Type $content_type;
    proxy_set_header Host $host;
    proxy_connect_timeout 300ms;
    proxy_send_timeout 1s;
    proxy_read_timeout 1s;
}

# The challenge band: whether this visitor already holds a CAPTCHA clearance
# (waf_clearance) for the host -- 204 yes, 401 no. Same visitor headers as the
# shield check, so the clearance is checked against the same address/UA.
location = /internal-ml-clearance {
    internal;
    proxy_method GET;
    proxy_pass http://control-api:8070/api/ml/clearance;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-Host $host;
    proxy_set_header X-Original-IP $waf_client_ip;
    proxy_set_header X-Original-User-Agent $http_user_agent;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Host $host;
    proxy_connect_timeout 300ms;
    proxy_read_timeout 1s;
}

location = /internal-captcha-check {
    internal;
    proxy_method GET;
    proxy_pass http://control-api:8070/api/captcha/access;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-Host $host;
    proxy_set_header X-Original-IP $waf_client_ip;
    proxy_set_header X-Original-User-Agent $http_user_agent;
    proxy_set_header Cookie $http_cookie;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location ^~ /cdn-cgi/ {
    modsecurity off;
    proxy_pass http://control-api:8070;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $waf_client_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Original-IP $waf_client_ip;
    proxy_set_header X-Original-User-Agent $http_user_agent;
    # $shield_type: set via auth_request_set from /internal-shield-check's
    # X-Shield-Type response header (default.conf.template), survives the
    # error_page 401 internal redirect into this location -- lets a single
    # /cdn-cgi/challenge route pick captcha vs OTP HTML. Empty on any other
    # /cdn-cgi/ hit (direct API calls), which is fine, unused there.
    proxy_set_header X-Shield-Type $shield_type;
    # Retry-After of a rate-limited request, for the 429 the challenge route
    # answers (empty, so not sent, on any other /cdn-cgi/ request).
    proxy_set_header X-Retry-After $retry_after;
    proxy_http_version 1.1;
    proxy_read_timeout 10s;
    proxy_buffering off;
}

error_page 401 = /cdn-cgi/challenge;
