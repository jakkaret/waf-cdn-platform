server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# The visitor's real IP (P2.5, H09/H18/H19/N14).
#
# Requests reach this server from our CDN edges, which put the client they
# saw in X-Real-IP, overwriting anything the client sent. nginx's realip
# module takes that header as the client address ($remote_addr) only when the
# connection comes from an edge, before any other phase runs -- so
# ModSecurity's REMOTE_ADDR, the IP block/allow rules (REMOTE_ADDR only), the
# shield, the rate limiter, the access log and X-Real-IP to the origin all see
# the same, unspoofable address. A request from anywhere else keeps its own
# address; whatever X-Real-IP it sent is ignored.
#
# The docker network is not trusted any more: Main's Caddy only serves the
# dashboard and never forwards to this server (nginx/Caddyfile), and the test
# containers on waf-net must not be able to choose their address.
#
# This list is also the allow-list for port 8080 in the host firewall
# (/etc/ufw/after.rules, DOCKER-USER): a new edge must be added in both places.
# The 10.88.0.x entries are the edges' WireGuard addresses
# (deploy/wireguard/README.md); the firewall accepts them only on wg0, so they
# cannot be spoofed from the internet. The public ones are the fallback path
# described there.
set_real_ip_from 45.154.26.91;   # edge-th
set_real_ip_from 57.158.25.236;  # edge-asia
set_real_ip_from 10.88.0.2;      # edge-th over WireGuard
set_real_ip_from 10.88.0.3;      # edge-asia over WireGuard
real_ip_header X-Real-IP;

# Kept as a name for the client address used throughout the templates and
# the generated site files (services/nginx_site_service.py).
map $remote_addr $waf_client_ip {
    default $remote_addr;
}

# P2.3: a path a CAPTCHA/OTP gate protects is answered with
# Cache-Control: private, no-store, so neither the edge cache nor any other
# shared cache keeps it ($shield_protected comes from the shield check).
# Everything else keeps the origin's own Cache-Control.
map $shield_protected $waf_cache_control {
    "1"     "private, no-store";
    default $upstream_http_cache_control;
}

# Gen 3 inline gate (nginx/njs/mlgate.js). services/ml_gate.py renders
# /etc/nginx/ml-gate/hosts.map from each origin's ML protection setting:
# "enforce:<challenge>:<block>" for a verified host of an origin in enforce
# mode, nothing for any other host. Empty $ml_gate = log mode: the gate sends
# the request straight on without calling ML. The include is a glob, so a
# missing file is the same as an empty one -- never a block.
map $host $ml_gate {
    default "";
    include /etc/nginx/ml-gate/*.map;
}
js_import mlgate from /etc/nginx/njs/mlgate.js;

upstream frp_tunnel_router {
    server 172.18.0.1:8085;
}

upstream cloudwaf_tunnel {
    server 172.18.0.1:8060;
    keepalive 32;
}

# 1. Default Fallback Server (Direct IP Access)
server {
    listen 8080 default_server;
    server_name _;

    access_log /var/log/nginx/access.json json_combined;
    error_log /var/log/nginx/error.log warn;
    include /etc/nginx/includes/captcha_server.conf;
    include /etc/nginx/includes/otp_server.conf;

    set $always_redirect off;
    modsecurity on;
    modsecurity_transaction_id "$request_id";

    location = /healthz {
        access_log off;
        return 200 "OK\n";
    }

    # Static Assets bypass rate limiting
    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|json|map)$ {
        # P2.1 (H85): files that look static are checked by the shield too;
        # a protected path with a static-looking name used to skip it.
        auth_request /internal-shield-check;
        auth_request_set $retry_after $upstream_http_retry_after;
        auth_request_set $shield_type $upstream_http_x_shield_type;
        auth_request_set $shield_protected $upstream_http_x_shield_protected;
        more_set_headers "Cache-Control: $waf_cache_control";

        proxy_pass http://frp_tunnel_router;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $waf_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location / {
        # Gen3 roadmap 3.1-A: lab-only telemetry mirror (fire-and-forget,
        # never affects the real response). Scope/redaction enforced
        # server-side in ml/capture_telemetry.py (allowlist, secret
        # redaction, size cap, retention) -- unchanged by this line.
        mirror /internal-ml-capture;
        mirror_request_body on;

        # Single auth_request per location is a real nginx constraint (not
        # multi-value). nginx's auth_request module only treats 401/403 as
        # valid "deny" statuses eligible for error_page mapping (other codes,
        # e.g. 418, make it log "unexpected status" and 500 instead) -- 403 is
        # ModSecurity's own block status here, so captcha and OTP share 401
        # via one combined check (nginx/includes/otp_server.conf) that tags
        # which gate failed on a header for the challenge page to read.
        auth_request /internal-shield-check;
        auth_request_set $retry_after $upstream_http_retry_after;
        auth_request_set $shield_type $upstream_http_x_shield_type;
        auth_request_set $shield_protected $upstream_http_x_shield_protected;

        # Gen 3 inline gate, after ModSecurity and the shield: a host in ML
        # enforce mode ($ml_gate set) is scored with its body and may get 403
        # or the challenge page; every other host goes straight to
        # @waf_origin, which answers (and sets Cache-Control). Fails open.
        # Bodies stay in one memory buffer up to 64k so the gate can read
        # them; a larger one is scored without its body.
        client_body_buffer_size 64k;
        client_body_in_single_buffer on;
        js_content mlgate.gate;
    }

    location @waf_origin {
        more_set_headers "Cache-Control: $waf_cache_control";

        proxy_pass http://frp_tunnel_router;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $waf_client_ip;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_buffering off;
    }


    error_page 418 = @deception;
    location @deception {
        rewrite ^ /api/deception/respond break;
        proxy_pass http://host.docker.internal:8000;
        proxy_connect_timeout 1s;
        # 10 s emulated time-based SQL injection + generation
        proxy_read_timeout 15s;
        proxy_set_header X-Internal-Deception-Key ${DECEPTION_INTERNAL_KEY};
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $waf_client_ip;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-Host $host;
        proxy_set_header X-Deception-Template "";
        proxy_set_header X-Matched-Rule-ID "";
        proxy_hide_header X-Deception-Engine;
        proxy_intercept_errors on;
        error_page 502 504 = @deception_static;
    }
    location @deception_static {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "root:x:0:0:root:/root:/bin/bash\ndaemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin\nbin:x:2:2:bin:/bin:/usr/sbin/nologin\nsys:x:3:3:sys:/dev:/usr/sbin/nologin\nwww-data:x:33:33:www-data:/var/www:/usr/sbin/nologin\nnobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin\n";
    }

    error_page 403 /403.html; 
    location = /403.html { root /usr/share/nginx/html; internal; }
    include includes/location_common.conf;
}

