# 4. VAmPI Lab Target (via CloudWAF self-hosted private tunnel)
#    Same chain as the FRP-backed hosts above: ModSecurity inspects the request
#    first, then it is handed to the tunnel server, which relays it down the
#    agent's outbound connection. The origin never accepts an inbound port.
server {
    listen 8080;
    server_name vampi.waf-it-kku.online;

    access_log /var/log/nginx/access.json json_combined;
    error_log /var/log/nginx/error.log warn;

    modsecurity on;
    modsecurity_transaction_id "$request_id";

    error_page 403 /403.html;
    location = /403.html {
        root /usr/share/nginx/html;
        internal;
    }

    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|json|map)$ {
        proxy_pass http://cloudwaf_tunnel;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location / {
        proxy_pass http://cloudwaf_tunnel;
        proxy_set_header Host $host;
        proxy_set_header Accept-Encoding "";
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 60s;
    }
}

