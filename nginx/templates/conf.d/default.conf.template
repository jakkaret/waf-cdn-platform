server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream dvwa_backend {
    server dvwa:80;
}

upstream frp_tunnel_router {
    server 172.18.0.1:8085;
}

upstream cloudwaf_tunnel {
    server 172.18.0.1:8060;
    keepalive 32;
}

# 1. Default Fallback Server (Direct IP Access)
server {
    listen 8080 default_server;
    server_name _;

    access_log /var/log/nginx/access.json json_combined;
    error_log /var/log/nginx/error.log warn;

    set $always_redirect off;
    modsecurity on;
    modsecurity_transaction_id "$request_id";

    location = /healthz {
        access_log off;
        return 200 "OK\n";
    }

    # Static Assets bypass rate limiting
    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|json|map)$ {
        proxy_pass http://dvwa_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
    }

    location / {
        auth_request /internal-rate-limit;
        auth_request_set $retry_after $upstream_http_retry_after;
        
        proxy_pass http://dvwa_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_redirect off;
        proxy_buffering off;
    }

    location = /internal-rate-limit {
        internal;
        proxy_method GET;
        proxy_pass http://host.docker.internal:8000/api/limiter/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Host $host;
    }

    error_page 401 =429 @rate_limit_exceeded;
    location @rate_limit_exceeded {
        add_header Retry-After $retry_after always;
        add_header Content-Type text/plain always;
        return 429 "Too Many Requests. Rate limit exceeded. Please try again later.";
    }

    error_page 403 /403.html; 
    location = /403.html { root /usr/share/nginx/html; internal; }
    include includes/location_common.conf;
}

