# /etc/waf-ml/waf-ml.env on the ML host (root:wafml, 640). install.sh creates it
# from this file with a random token; edit, then: sudo systemctl restart waf-ml

# Address uvicorn listens on. 127.0.0.1 until WireGuard is up, then the ML host's
# WireGuard address (10.77.0.2) so only the VPS can reach it. Never 0.0.0.0.
WAF_ML_BIND=127.0.0.1
WAF_ML_PORT=5000
# 1 worker per ~1 GB RAM (each ~250 MB); B1ms/B1s: 1, B2s/B2als_v2: 2
WAF_ML_WORKERS=1

# Shared secret: every request must carry header X-WAF-ML-Token with this value.
# The VPS sends it as ML_SERVICE_TOKEN (deploy/azure-ml/vps-ml-client.env.example).
WAF_ML_API_TOKEN=change-me

# Engine behind /predict-fast (Nginx shadow hook via the backend):
#   rf   = RandomForest ONNX, 13 features (what the VPS runs today)
#   gen3 = Gen 3 model (feature set F), gen3_f_noopenappsec.onnx - shadow only, not promoted
WAF_FAST_ENGINE=rf
WAF_GEN3_ONNX_PATH=/opt/waf_project/ml/models/gen3/gen3_f_noopenappsec.onnx

# Lab telemetry capture (/capture). Off by default so production request samples
# do not leave the VPS; enable only with the advisor's approval.
WAF_CONTROLLED_CAPTURE_ENABLED=false
