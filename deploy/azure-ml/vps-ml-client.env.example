# /etc/waf-ml-client.env on the main WAF VPS (root, chmod 600).
# Read by the backend (waf-dashboard) and the log analyzer through the systemd
# drop-ins in vps-systemd/. Needs the backend code with env support
# (dashboard/backend/api/ml.py on main of waf-cdn-platform).

# ML host over WireGuard (backend: dashboard/backend/api/ml.py)
ML_SERVICE_URL=http://10.77.0.2:5000
# log analyzer: ml/async_log_analyzer.py
ML_API_URL=http://10.77.0.2:5000
# = WAF_ML_API_TOKEN in /etc/waf-ml/waf-ml.env on the ML host
ML_SERVICE_TOKEN=<token>
# Nginx shadow hook / capture budget in seconds; fail open beyond it.
# Keep >= 3 x the VPS -> ML host round trip (smoke_test.sh prints it).
ML_FAST_TIMEOUT=0.5
# Empty = do not forward lab telemetry capture (production samples stay on the VPS)
ML_CAPTURE_URL=
