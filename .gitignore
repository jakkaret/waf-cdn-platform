# Environment
.env*
AWSCLIV2.pkg
logs/
*.log
*.session
waf_alert_bot.session
*.bak*
*.bak

# Virtual Environment
.venv/

# TypeScript incremental build cache (generated)
*.tsbuildinfo

# Python
__pycache__/
*.pyc

# ML Datasets (Auto-downloaded by ml/download_dataset.py)
ml/dataset/*.csv
# ML data and artifacts that must never reach this public repo: datasets
# (including labelled production traffic), captured request telemetry, and
# training-candidate archives (pickled models, audit samples).
# Exception: ml/training/<model>/data/ keeps the PUBLIC datasets (CSIC 2010,
# SR-BH 2020) a served model was trained on, gzipped, so it can be rebuilt.
ml/dataset/
ml/telemetry/
ml/models/archive/

# OS
.DS_Store

# Telethon session files
*.session
*.session-journal

# React files
.node_modules/
node_modules/
dist/
*.tsbuildinfo

# Legacy archive
old/

.impeccable/
.agents/
.claude/
.codex/
# Local AI tool files under .github stay ignored; CI and Dependabot config is tracked.
.github/*
!.github/workflows/
!.github/dependabot.yml

# AI tool scratch files
.aider*

# Local DB/config backups (large; contain data dumps) -- never commit
backups/

# vuln-scan report output (generated)
reports/vuln-scan/

# GeoIP database: an 8 MB monthly download (scripts/update_geoip.py), not source
dashboard/backend/data/geoip/

# docs site build (docs/site): generated outputs and the node_modules link
docs/node_modules
docs/diagrams/rendered/
docs/site/.vitepress/cache/

# Generated at runtime by dashboard/backend/services/managed_ruleset.py and
# tenant_rules.py -- tenant rules are customer data (and this repo is public),
# the catalog is the published-version ledger. Source of truth for managed
# rules is modsecurity/managed-rules/ (tracked).
modsecurity/custom-rules/managed-*.conf
modsecurity/custom-rules/tenant-*.conf
dashboard/backend/data/managed_ruleset.json

# Mode A site configs written at runtime by services/nginx_site_service.py;
# they carry DECEPTION_INTERNAL_KEY.
nginx/custom_sites/

# Database/service passwords created by deploy/postgres/bootstrap.sh -- never commit
/secrets/

# Build caches and retired runtime data (H90, H91)
.pycache/
*.db
*.db.*
