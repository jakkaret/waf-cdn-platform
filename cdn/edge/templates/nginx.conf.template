load_module modules/ngx_http_modsecurity_module.so;
load_module modules/ngx_http_headers_more_filter_module.so;

worker_processes auto;
pid /tmp/nginx.pid;

events {
    worker_connections 2048;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    keepalive_timeout 60s;
    sendfile on;

    # --- Real IP Configuration (Extract true client IP from Caddy / Proxy) ---
    # Live on both edges before it was committed (merged 2026-10-16): Caddy in
    # the same compose network appends the visitor to X-Forwarded-For, and the
    # rightmost address not in these ranges is taken as the client.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 127.0.0.1;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    log_format cdn_json escape=json
        '{"time":"$time_iso8601",'
        '"request_id":"$request_id",'
        '"region":"${EDGE_REGION}",'
        '"remote_addr":"$remote_addr",'
        '"host":"$host",'
        '"method":"$request_method",'
        '"uri":"$request_uri",'
        '"request_uri":"$request_uri",'
        '"status":"$status",'
        '"cache_status":"$upstream_cache_status",'
        '"upstream":"$upstream_addr",'
        '"request_time":"$request_time",'
        '"upstream_response_time":"$upstream_response_time",'
        '"http_user_agent":"$http_user_agent"}';

    # --- Cache-Control sent to visitors (P2.3, H14) ---
    # "$status|$skip_cache|origin's Cache-Control". Only a 2xx/3xx answer to a
    # cacheable request (no cookie, no Authorization...) that the origin sent
    # without Cache-Control is marked public; everything else keeps the
    # origin's header, so private/no-store from Main survives the edge.
    map "$status|$skip_cache|$upstream_http_cache_control" $edge_cache_control_dynamic {
        default                 $upstream_http_cache_control;
        "~^[23][0-9][0-9]\|0\|$" "public, max-age=600, must-revalidate";
    }
    map "$status|$skip_cache|$upstream_http_cache_control" $edge_cache_control_static {
        default                 $upstream_http_cache_control;
        "~^[23][0-9][0-9]\|0\|$" "public, max-age=3600, immutable";
    }

    # --- Rate Limiting Zone (per real client IP) ---
    limit_req_zone $binary_remote_addr zone=edge_ratelimit:20m rate=${RATE_LIMIT_RPS}r/s;
    limit_req_status 429;

    # --- SSL Session Settings (shared across server blocks) ---
    ssl_session_timeout 1d;
    ssl_session_cache shared:EdgeSSL:10m;
    ssl_session_tickets off;

    proxy_cache_path /var/cache/nginx/edge
        levels=1:2
        keys_zone=edge_cache:80m
        max_size=2g
        inactive=24h
        use_temp_path=off;

    resolver 127.0.0.11 valid=5s;
    include /etc/nginx/conf.d/*.conf;
}
