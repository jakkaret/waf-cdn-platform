server_tokens off;

# --- FORCE_HTTPS redirect map ---
# When FORCE_HTTPS=true, HTTP requests get redirected to HTTPS
map "${FORCE_HTTPS}" $force_https {
    "true"  1;
    default 0;
}

upstream website_origin {
    server ${ORIGIN_HOST}:${ORIGIN_PORT};
    keepalive 64;
}

# ============================================================
# HTTP Server (port 80) — kept for backward compatibility
# ============================================================
server {
    listen 80;
    server_name _;

    access_log /dev/stdout cdn_json;
    access_log /var/log/nginx/cdn/access.json cdn_json;
    error_log /dev/stderr warn;

    modsecurity on;
    modsecurity_transaction_id "$request_id";

    # --- Rate Limiting: custom 429 error page ---
    error_page 429 /429.html;
    location = /429.html {
        root /usr/share/nginx/html;
        internal;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status": "ok", "region": "${EDGE_REGION}", "timestamp": "$time_iso8601"}\n';
    }

    # --- FORCE_HTTPS redirect (conditional) ---
    if ($force_https) {
        return 301 https://$host$request_uri;
    }

    # --- Dynamic Content (default) — cache 10 min, strict rate limit ---
    location / {
        # --- Rate Limiting (strict for API/dynamic) ---
        limit_req zone=edge_ratelimit burst=${RATE_LIMIT_BURST} nodelay;
        add_header X-RateLimit-Limit "${RATE_LIMIT_RPS} req/s, burst=${RATE_LIMIT_BURST}" always;

        set $skip_cache 0;

        if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
        if ($http_authorization != "") { set $skip_cache 1; }
        if ($http_cookie ~* "PHPSESSID|security=") { set $skip_cache 1; }
        if ($http_cache_control ~* "no-cache|no-store") { set $skip_cache 1; }
        if ($args != "") { set $skip_cache 1; }

        proxy_cache edge_cache;
        proxy_cache_key "$request_method|$uri";
        proxy_cache_valid 200 301 302 10m;
        proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        proxy_cache_lock on;

        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;

        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Region ${EDGE_REGION} always;
        add_header Cache-Control "public, max-age=600, must-revalidate" always;

        proxy_pass http://website_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }

    # --- Static Assets — cache 1 hour, relaxed rate limit ---
    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        # --- Rate Limiting (relaxed for static assets) ---
        limit_req zone=edge_ratelimit burst=${RATE_LIMIT_BURST_STATIC} nodelay;
        add_header X-RateLimit-Limit "${RATE_LIMIT_RPS} req/s, burst=${RATE_LIMIT_BURST_STATIC}" always;

        set $skip_cache 0;

        if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
        if ($http_authorization != "") { set $skip_cache 1; }
        if ($http_cookie ~* "PHPSESSID|security=") { set $skip_cache 1; }
        if ($http_cache_control ~* "no-cache|no-store") { set $skip_cache 1; }
        if ($args != "") { set $skip_cache 1; }

        proxy_cache edge_cache;
        proxy_cache_key "$request_method|$uri";
        proxy_cache_valid 200 301 302 1h;
        proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        proxy_cache_lock on;

        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;

        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Region ${EDGE_REGION} always;
        add_header Cache-Control "public, max-age=3600, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;

        proxy_pass http://website_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
    }
}

# ============================================================
# HTTPS Server (port 443) — TLS termination at edge
# ============================================================
server {
    listen 443 ssl;
    server_name _;

    access_log /dev/stdout cdn_json;
    access_log /var/log/nginx/cdn/access.json cdn_json;
    error_log /dev/stderr warn;

    # --- TLS Configuration (matches WAF main config) ---
    ssl_certificate /etc/nginx/ssl/edge.crt;
    ssl_certificate_key /etc/nginx/ssl/edge.key;
    ssl_dhparam /etc/nginx/ssl/dhparam-2048.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    modsecurity on;
    modsecurity_transaction_id "$request_id";

    # --- Rate Limiting: custom 429 error page ---
    error_page 429 /429.html;
    location = /429.html {
        root /usr/share/nginx/html;
        internal;
    }

    location = /healthz {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status": "ok", "region": "${EDGE_REGION}", "timestamp": "$time_iso8601"}\n';
    }

    # --- Dynamic Content (default) — cache 10 min, strict rate limit ---
    location / {
        # --- Rate Limiting (strict for API/dynamic) ---
        limit_req zone=edge_ratelimit burst=${RATE_LIMIT_BURST} nodelay;
        add_header X-RateLimit-Limit "${RATE_LIMIT_RPS} req/s, burst=${RATE_LIMIT_BURST}" always;

        set $skip_cache 0;

        if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
        if ($http_authorization != "") { set $skip_cache 1; }
        if ($http_cookie ~* "PHPSESSID|security=") { set $skip_cache 1; }
        if ($http_cache_control ~* "no-cache|no-store") { set $skip_cache 1; }
        if ($args != "") { set $skip_cache 1; }

        proxy_cache edge_cache;
        proxy_cache_key "$request_method|$uri";
        proxy_cache_valid 200 301 302 10m;
        proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        proxy_cache_lock on;

        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;

        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Region ${EDGE_REGION} always;
        add_header Cache-Control "public, max-age=600, must-revalidate" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        proxy_pass http://website_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }

    # --- Static Assets — cache 1 hour, relaxed rate limit ---
    location ~* \.(?:css|js|jpg|jpeg|png|gif|ico|svg|webp|woff|woff2|ttf|eot)$ {
        # --- Rate Limiting (relaxed for static assets) ---
        limit_req zone=edge_ratelimit burst=${RATE_LIMIT_BURST_STATIC} nodelay;
        add_header X-RateLimit-Limit "${RATE_LIMIT_RPS} req/s, burst=${RATE_LIMIT_BURST_STATIC}" always;

        set $skip_cache 0;

        if ($request_method !~ ^(GET|HEAD)$) { set $skip_cache 1; }
        if ($http_authorization != "") { set $skip_cache 1; }
        if ($http_cookie ~* "PHPSESSID|security=") { set $skip_cache 1; }
        if ($http_cache_control ~* "no-cache|no-store") { set $skip_cache 1; }
        if ($args != "") { set $skip_cache 1; }

        proxy_cache edge_cache;
        proxy_cache_key "$request_method|$uri";
        proxy_cache_valid 200 301 302 1h;
        proxy_cache_use_stale error timeout invalid_header updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        proxy_cache_lock on;

        proxy_cache_bypass $skip_cache;
        proxy_no_cache $skip_cache;

        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Edge-Region ${EDGE_REGION} always;
        add_header Cache-Control "public, max-age=3600, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        proxy_pass http://website_origin;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
    }
}
