# ML decision harness (ml/security_test/waf_test_harness.py) as a container, so the
# open-appsec benchmark can put it behind CRS on any machine with Docker.
# python:3.12 (not slim): libinjection-python builds from source and needs gcc.
FROM python:3.12
WORKDIR /app
COPY ml/requirements-serve.txt /tmp/requirements-serve.txt
RUN pip install --no-cache-dir -r /tmp/requirements-serve.txt
# The repo is mounted at /app at run time (code + model), nothing else is baked in.
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
EXPOSE 8088
CMD ["uvicorn", "ml.security_test.waf_test_harness:app", "--host", "0.0.0.0", "--port", "8088", "--no-access-log"]
