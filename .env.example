#Telegram
TELEGRAM_API_ID = ""
TELEGRAM_API_HASH = ""
TELEGRAM_BOT_TOKEN = ""
TELEGRAM_CHAT_ID = ""

# PostgreSQL (control-plane database, service `postgres` in docker-compose.yml).
# deploy/postgres/bootstrap.sh fills these in: it writes random passwords to
# WAF_SECRETS_DIR (outside git) and appends DATABASE_URL / DATABASE_URL_MAINT.
WAF_SECRETS_DIR=./secrets
WAF_BACKUP_DIR=./backups/pg
# WAF_PG_PORT=5432
# DATABASE_URL=postgresql://waf_app_login:<from bootstrap>@127.0.0.1:5432/waf
# DATABASE_URL_MAINT=postgresql://waf_maint_login:<from bootstrap>@127.0.0.1:5432/waf
# Self-registration never grants admin; create the first admin with
# dashboard/backend/scripts/seed_admin.py.

#JWT
# Empty: deploy/postgres/bootstrap.sh generates a random key.
JWT_SECRET_KEY=""
JWT_EXPIRE_MINUTES=60

# Service secrets docker-compose.yml requires. Empty: deploy/postgres/bootstrap.sh
# generates random values. ClickHouse is reached from the host-run dashboard.
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=""
# control-api write token; also the captcha/OTP cookie HMAC key
CONTROL_TOKEN=""
# shared by nginx, control-api and the dashboard's internal ML relay
ML_RELAY_SECRET=""
# frps auth.token (/etc/frp/frps.toml) and the token agents put in frpc.toml
FRP_AUTH_TOKEN=""

# CORS — allowed frontend origins (comma-separated)
# [S1] ตั้งให้ตรงกับ URL จริงของ frontend ห้ามใช้ * ใน production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# [S3] Google OAuth — email domain ที่ auto-promote เป็น admin
# เช่น ADMIN_EMAIL_DOMAIN=mycompany.com → user@mycompany.com จะได้ role admin
# ถ้าไม่กำหนดหรือปล่อยว่าง: ทุก Google user จะได้ viewer เท่านั้น
ADMIN_EMAIL_DOMAIN=

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# CDN edge origin target (from existing project)
CDN_ORIGIN_HOST=dvwa
CDN_ORIGIN_PORT=80

# WAF tuning for edge nodes
CDN_PARANOIA=1
CDN_ANOMALY_INBOUND=10
CDN_ANOMALY_OUTBOUND=10

# Purge API token (must match dashboard env if using /api/cdn/purge)
CDN_PURGE_TOKEN=***REDACTED***

# GeoDNS simulation
GEODNS_DOMAIN=cdn.local
GEODNS_DEFAULT_REGION=TH
GEODNS_TTL=20

# Rate Limiting per Edge (requests per second / burst)
RATE_LIMIT_RPS_SG=30
RATE_LIMIT_BURST_SG=60
RATE_LIMIT_RPS_JP=30
RATE_LIMIT_BURST_JP=60
RATE_LIMIT_RPS_TH=50
RATE_LIMIT_BURST_TH=100

# Static assets burst (relaxed, 2x dynamic burst)
RATE_LIMIT_BURST_STATIC_SG=120
RATE_LIMIT_BURST_STATIC_JP=120
RATE_LIMIT_BURST_STATIC_TH=200

# TLS / HTTPS — set to true to redirect HTTP→HTTPS on all edges
FORCE_HTTPS=false

# External network name from existing project compose
WAF_NETWORK_NAME=waf_project_waf-net

# OTP Shield (opt-in edge login gate, see OTP_SHIELD_PLAN.md) — email
# delivery. Unset by default: cdn/control-api/email_sender.py fails loud and
# logs rather than pretending an email went out until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
